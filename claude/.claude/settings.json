{
  "editorMode": "normal",
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "claude-mem@thedotmack": true
  },
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "repo": "thedotmack/claude-mem",
        "source": "github"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/Users/jeremytubongbanua/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Grep",
      "Glob",
      "Bash(cat *)",
      "Bash(dart *)",
      "Bash(flutter *)",
      "Bash(find *)",
      "Bash(which *)",
      "Bash(cd *)",
      "Bash(echo *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(gh repo view *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "WebFetch",
      "WebSearch",
      "Read(*)"
    ],
    "ask": [],
    "defaultMode": "default",
    "deny": []
  },
  "statusLine": {
    "command": "bash /Users/jeremytubongbanua/.claude/statusline-command.sh",
    "type": "command"
  },
  "theme": "auto"
}
