{
  "lastChangelogVersion": "0.84.4",
  "theme": "light/dark",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-lens",
    "npm:pi-web-access",
    "npm:pi-multi-account@1.21.2"
  ],
  "retry": {
    "provider": {
      "maxRetries": 0
    }
  },
  "subagents": {
    "agentScanDirs": [
      "~/.agents/agents"
    ]
  },
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-4-6",
  "enabledModels": [
    "anthropic*/*",
    "openai*/*"
  ],
  "defaultThinkingLevel": "medium",
  "warnings": {
    "anthropicExtraUsage": false
  },
  "hideThinkingBlock": true,
  "terminal": {
    "showImages": true,
    "imageWidthCells": 120,
    "showTerminalProgress": false
  },
  "editorPaddingX": 0,
  "autocompleteMaxVisible": 3,
  "outputPad": 0,
  "steeringMode": "all",
  "followUpMode": "one-at-a-time",
  "transport": "auto",
  "markdown": {
    "mermaid": "streaming"
  }
}