{
  "lastChangelogVersion": "0.86.1",
  "theme": "catppuccin-latte/catppuccin-mocha",
  "packages": [
    "npm:@narumitw/pi-usage",
    "npm:pi-lens",
    "npm:pi-mcp-adapter",
    "npm:pi-multi-account",
    "npm:pi-tool-display@0.5.0",
    "npm:pi-web-access@0.29.0",
    "npm:pi-btw",
    "git:github.com/badlogic/pi-skills",
