#!/usr/bin/env zsh

emulate -L zsh
setopt err_exit pipe_fail

die() {
  print -u2 -- "bd-dispatch: $*"
  exit 1
}

id="$1"
[[ $id =~ '^[A-Za-z0-9._-]+$' ]] || die 'usage: bd-dispatch <issue-id>'
[[ ${HERDR_ENV:-} == 1 && -n ${HERDR_TAB_ID:-} && -n ${HERDR_WORKSPACE_ID:-} ]] || die 'not running inside a herdr pane'

case "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" in
  "$HOME/.claude-work") agent=claude-work ;;
  *) agent=claude ;;
esac

index="$(herdr tab list --workspace "$HERDR_WORKSPACE_ID" | jq --arg tab "$HERDR_TAB_ID" '.result.tabs | map(.tab_id) | index($tab)')"
[[ $index == <-> ]] || die "could not find tab $HERDR_TAB_ID in workspace $HERDR_WORKSPACE_ID"

created="$(herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$PWD" --label "$id" --no-focus)"
tab="$(print -r -- "$created" | jq -r '.result.tab.tab_id')"
pane="$(print -r -- "$created" | jq -r '.result.root_pane.pane_id')"

jq -cn --arg tab "$tab" --argjson index "$(( index + 1 ))" \
  '{id: "bd-dispatch", method: "tab.move", params: {tab_id: $tab, insert_index: $index}}' \
  | nc -U -w 2 "${HERDR_SOCKET_PATH:-$HOME/.config/herdr/herdr.sock}" >/dev/null

herdr pane run "$pane" "$agent '/bd-work $id'" >/dev/null

print -r -- "dispatched $id to tab $tab (pane $pane) running $agent"
