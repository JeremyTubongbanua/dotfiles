# https://www.nerdfonts.com/font-downloads

# Font
# font-family = Lekton Nerd Font
font-family = JetBrainsMono Nerd Font
font-size = 16

# Theme
# theme = Espresso
theme = "light:Flexoki Light,dark:tokyonight-storm"

# Background
background-opacity = 0.8
background-blur-radius = 20

macos-option-as-alt = true
shell-integration-features = cursor,no-sudo
# keybind="unconsumed:super+c=copy_to_clipboard"

keybind=super+c=copy_to_clipboard
keybind=super+v=paste_from_clipboard
#
# fixes shift+enter new line
keybind = shift+enter=text:\n 

# keybind = cmd+shift+t=prompt_tab_title # Cmd+Shift+T = change Ghostty tab

# Cmd+D: new split right, then shrink it down to ~1/3 of the window
keybind = cmd+d=new_split:right
keybind = chain=resize_split:right,10
keybind = chain=resize_split:right,10
keybind = chain=resize_split:right,10
keybind = chain=resize_split:right,10
