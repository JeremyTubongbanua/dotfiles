# https://www.nerdfonts.com/font-downloads

# Font
# font-family = Lekton Nerd Font
# font-family = JetBrainsMono Nerd Font
font-family = "Fira Code Regular"

# https://github.com/paper-design/paper-mono
# font-family = "Paper Mono"
font-size = 16

# Theme
# theme = Espresso
theme = "light:Catppuccin Latte,dark:Catppuccin Mocha"
# theme = "light:Flexoki Light,dark:TokyoNight Storm"

# Background
background-opacity = 0.95
background-blur-radius = 20

macos-option-as-alt = true
shell-integration-features = cursor,no-sudo
# keybind="unconsumed:super+c=copy_to_clipboard"

keybind=super+c=copy_to_clipboard
keybind=super+v=paste_from_clipboard

# fixes shift+enter new line
keybind = shift+enter=text:\n 

# keybind = cmd+d=new_split:right
# keybind = ctrl+w>period=resize_split:right,1000
# keybind = ctrl+w>period=resize_split:right,200
# keybind = ctrl+w>comma=resize_split:left,200

# Cmd+[ / Cmd+]: directional split nav — stops at edges instead of wrapping
# (default is goto_split:previous/next, which cycles back around)
resize-overlay = always
keybind = cmd+d=new_split:right
keybind = super+[=goto_split:left
keybind = super+]=goto_split:right
