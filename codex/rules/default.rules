prefix_rule(pattern=["dart", "format"], decision="allow")
prefix_rule(pattern=["dart", "analyze"], decision="allow")
prefix_rule(pattern=["rm", "-rf", "assets"], decision="allow")
prefix_rule(pattern=["curl", "-sSL"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "docker stop $(docker ps -q) 2>/dev/null ; rm -rf e2e_all_v2/ && dart run tests/e2e_all_v2/bin/core_tests.dart --client-atsign \"@client_jttest\" --daemon-atsign \"@device_jttest\" --relay-atsign \"@rv_am\" --policy-atsign \"@policy_jttest\" --events-atsign \"@events_jttest\" --base-directory \"e2e_all_v2\" --root-domain \"root.atsign.org\" --batch-size 3"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "docker stop $(docker ps -q) 2>/dev/null ; rm -rf e2e_all_v2/ && dart run tests/e2e_all_v2/bin/core_tests.dart --client-atsign \"@client_jttest\" --daemon-atsign \"@device_jttest\" --relay-atsign \"@rv_am\" --npp-atsign \"@policy01_jttest\" --npp-atserver-atsign \"@policy02_jttest\" --base-directory \"npe2e_policy\" --root-domain \"root.atsign.org:64\" --batch-size 3"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "docker stop $(docker ps -q) 2>/dev/null ; rm -rf npe2e_policy/ && dart run tests/e2e_all_v2/bin/policy_tests.dart --client-atsign \"@client_jttest\" --daemon-atsign \"@device_jttest\" --npp-atsign \"@policy01_jttest\" --npp-atserver-atsign \"@policy02_jttest\" --base-directory \"npe2e_policy\" --root-domain \"root.atsign.org:64\" --batch-size 3"], decision="allow")
prefix_rule(pattern=["docker", "ps"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "docker stop $(docker ps -q) 2>/dev/null ; rm -rf npe2e_policy/ && dart run tests/e2e_all_v2/bin/policy_tests.dart --client-atsign \"@client_jttest\" --daemon-atsign \"@device_jttest\" --relay-atsign \"@rv_am\" --npp-atsign \"@policy01_jttest\" --npp-atserver-atsign \"@policy02_jttest\" --base-directory \"npe2e_policy\" --root-domain \"root.atsign.org:64\" --batch-size 3"], decision="allow")
prefix_rule(pattern=["dart", "pub"], decision="allow")
prefix_rule(pattern=["dart", "run"], decision="allow")
prefix_rule(pattern=["pgrep"], decision="allow")
prefix_rule(pattern=["kill"], decision="allow")
prefix_rule(pattern=["git", "rm", "--cached"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "awk '/^export GOOGLE_CLOUD_API_KEY=/{p=1} p{print} /^export SUPABASE_PASSWORD=/{p=0}' ~/.zshrc > ~/.zshrc.local"], decision="allow")
prefix_rule(pattern=["chmod", "600"], decision="allow")
prefix_rule(pattern=["perl", "-0pi", "-e", "s/\\nexport GOOGLE_CLOUD_API_KEY=.*?\\nexport SUPABASE_PASSWORD=.*?\\n/\\n[ -f \"\\$HOME\\/.zshrc.local\" ] && source \"\\$HOME\\/.zshrc.local\"\\n/s", "~/.zshrc"], decision="allow")
prefix_rule(pattern=["git", "add"], decision="allow")
prefix_rule(pattern=["rm", "-rf", "npe2e_relay"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "docker stop $(docker ps -q) 2>/dev/null ; rm -rf tests/e2e_all_v2/npe2e_relay/"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "docker stop $(docker ps -q) 2>/dev/null ; rm -rf tests/e2e_all_v2/npe2e_relay/ && dart run tests/e2e_all_v2/bin/relay_tests.dart --client-atsign \"@client_jttest\" --daemon-atsign \"@device_jttest\" --prod-relay-atsign \"@rv_am\" --self-relay-atsign \"@relay_jttest\" --root-domain \"root.atsign.org\" --base-directory \"tests/e2e_all_v2/npe2e_relay\" --client-versions \"d:current\" --daemon-versions \"d:current\" --self-relay-versions \"d:current\" --batch-size 6"], decision="allow")
